<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeviceProtocolAnalyzer.ViewModels"
        xmlns:models="using:DeviceProtocolAnalyzer.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="900"
        x:Class="DeviceProtocolAnalyzer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Device Protocol Analyzer"
        Width="1200"
        Height="850"
        MinWidth="900"
        MinHeight="650"
        Background="#F1F2F6">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="2,0,0,2" />
        </Style>
        <Style Selector="ComboBox, TextBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Border.panel ComboBox, Border.panel TextBox">
            <Setter Property="Background" Value="#F1F2F6" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#0A84FF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#006EE6" />
            <Setter Property="TextBlock.Foreground" Value="White" />
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="#22808080" />
        </Style>
        <Style Selector="Border.pill.on">
            <Setter Property="Background" Value="#2E34C759" />
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="#8A8A8A" />
        </Style>
        <Style Selector="Border.on Ellipse.dot">
            <Setter Property="Fill" Value="#34C759" />
        </Style>
        <Style Selector="Border.logItem">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Background" Value="#F4F5F8" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
        </Style>
        <Style Selector="Border.logItem.tx">
            <Setter Property="BorderBrush" Value="#F59E0B" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="#0A84FF" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Border.gpanel">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="#F1F2F6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24,20,24,20" RowSpacing="16">

        <!-- 헤더 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
                <TextBlock Text="Device Protocol Analyzer" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="프로토콜 분석을 위한 시리얼 장비 바이트 수집" Opacity="0.6" />
            </StackPanel>
            <Border Grid.Column="1" Classes="pill" Classes.on="{Binding IsConnected}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Classes="dot" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 본문: 좌측 설정 / 우측 로그 -->
        <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="16">
            <Grid Grid.Column="0" RowDefinitions="*,Auto" RowSpacing="8">
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">

                    <Border Classes="card">
                        <StackPanel Spacing="7">
                            <TextBlock Classes="cardTitle" Text="세션 정보" Margin="0" />
                            <StackPanel>
                                <TextBlock Classes="label" Text="제조사" />
                                <TextBox Text="{Binding Manufacturer}" PlaceholderText="제조사명" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Classes="label" Text="모델" />
                                <TextBox Text="{Binding Model}" PlaceholderText="모델명" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Classes="label" Text="테스트 이름" />
                                <TextBox Text="{Binding TestName}" PlaceholderText="50000x2_10000x3" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Classes="label" Text="메모" />
                                <TextBox Text="{Binding Memo}" PlaceholderText="테스트 조건과 메모" AcceptsReturn="True" MinHeight="48" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel IsVisible="{Binding SessionDirectory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Classes="label" Text="세션 폴더" />
                                <TextBlock Text="{Binding SessionDirectory}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                                <Button Grid.Column="0" Classes="accent" Content="세션 시작" Command="{Binding StartSessionCommand}" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" Content="세션 종료" Command="{Binding StopSessionCommand}" HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="7">
                            <TextBlock Classes="cardTitle" Text="시리얼 연결" Margin="0" />
                            <TextBlock Text="{Binding PortNotice}" FontWeight="SemiBold" Foreground="#2E9E4F" TextWrapping="Wrap"
                                       IsVisible="{Binding PortNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <StackPanel>
                                <TextBlock Classes="label" Text="포트" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}" />
                                    <Button Grid.Column="1" Content="새로고침" Command="{Binding RefreshPortsCommand}" />
                                </Grid>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Classes="label" Text="통신 속도(Baud)" />
                                    <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaudRate}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Classes="label" Text="데이터 비트" />
                                    <ComboBox ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding SelectedDataBits}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Classes="label" Text="패리티" />
                                    <ComboBox ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding SelectedParity}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Classes="label" Text="정지 비트" />
                                    <ComboBox ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding SelectedStopBits}" />
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="DTR/RTS 켜기" IsChecked="{Binding DtrRtsEnable}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Classes="accent" Content="연결" Command="{Binding ConnectCommand}" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" Content="연결 해제" Command="{Binding DisconnectCommand}" HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Spacing="8" Margin="4,0,4,0">
                <Button Content="사용 가이드" HorizontalAlignment="Stretch">
                    <Button.Flyout>
                        <Flyout Placement="RightEdgeAlignedBottom">
                            <ScrollViewer Width="470" MaxHeight="620" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10" Margin="0,0,10,0">
                                <StackPanel Spacing="2" Margin="2,0,0,2">
                                    <TextBlock Text="사용 가이드" FontSize="20" FontWeight="Bold" />
                                    <TextBlock Text="시리얼(COM) 장비가 PC로 보내는 원본 바이트를 해석 없이 그대로 기록합니다." TextWrapping="Wrap" Opacity="0.6" />
                                </StackPanel>
                                <Border Classes="gpanel">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="기본 순서" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                                <Grid ColumnDefinitions="30,*" Margin="0,3">
                                    <Border Classes="badge"><TextBlock Text="1" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <TextBlock Grid.Column="1" Text="장비를 USB 또는 시리얼 케이블로 PC에 연결합니다." TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="30,*" Margin="0,3">
                                    <Border Classes="badge"><TextBlock Text="2" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <TextBlock Grid.Column="1" Text="새 포트가 잡히면 자동 선택됩니다. 안 보이면 장치 관리자(Windows)에서 COM 번호를 확인하세요." TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="30,*" Margin="0,3">
                                    <Border Classes="badge"><TextBlock Text="3" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <TextBlock Grid.Column="1" Text="제조사, 모델, 테스트 이름, 메모를 적습니다." TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="30,*" Margin="0,3">
                                    <Border Classes="badge"><TextBlock Text="4" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <TextBlock Grid.Column="1" Text="[세션 시작]을 누르면 기록용 폴더가 만들어집니다." TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="30,*" Margin="0,3">
                                    <Border Classes="badge"><TextBlock Text="5" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <TextBlock Grid.Column="1" Text="통신 설정을 장비에 맞춘 뒤 [연결]을 누릅니다." TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="30,*" Margin="0,3">
                                    <Border Classes="badge"><TextBlock Text="6" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <TextBlock Grid.Column="1" Text="장비에서 데이터를 보내는 동작을 합니다. 오른쪽 기록에 시간, 바이트 수, HEX, ASCII가 표시됩니다." TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="30,*" Margin="0,3">
                                    <Border Classes="badge"><TextBlock Text="7" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <TextBlock Grid.Column="1" Text="끝나면 [연결 해제] → [세션 종료]를 누릅니다." TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Classes="gpanel">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="통신 설정" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                                <Grid ColumnDefinitions="16,*" Margin="0,3"><TextBlock Text="•" Opacity="0.5" /><TextBlock Grid.Column="1" Text="장비 설명서의 값과 같아야 합니다. 모르면 9600 / 8 / None / One으로 시작하세요." TextWrapping="Wrap" /></Grid>
                                <Grid ColumnDefinitions="16,*" Margin="0,3"><TextBlock Text="•" Opacity="0.5" /><TextBlock Grid.Column="1" Text="데이터가 안 들어오면 [DTR/RTS 켜기]를 체크하고 다시 연결해 보세요. USB 가상 포트 장비는 이 옵션이 필요한 경우가 많습니다." TextWrapping="Wrap" /></Grid>
                                <Grid ColumnDefinitions="16,*" Margin="0,3"><TextBlock Text="•" Opacity="0.5" /><TextBlock Grid.Column="1" Text="글자가 깨져 보이면 통신 속도나 패리티가 맞지 않은 것입니다." TextWrapping="Wrap" /></Grid>
                                    </StackPanel>
                                </Border>
                                <Border Classes="gpanel">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="송신 (필요할 때만)" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                                <Grid ColumnDefinitions="16,*" Margin="0,3"><TextBlock Text="•" Opacity="0.5" /><TextBlock Grid.Column="1" Text="장비가 명령을 받아야 응답하는 경우에만 사용합니다." TextWrapping="Wrap" /></Grid>
                                <Grid ColumnDefinitions="16,*" Margin="0,3"><TextBlock Text="•" Opacity="0.5" /><TextBlock Grid.Column="1" Text="ASCII: 입력한 문자를 그대로 보냅니다." TextWrapping="Wrap" /></Grid>
                                <Grid ColumnDefinitions="16,*" Margin="0,3"><TextBlock Text="•" Opacity="0.5" /><TextBlock Grid.Column="1" Text="HEX: 공백으로 구분한 바이트를 보냅니다. 예) 02 41 03" TextWrapping="Wrap" /></Grid>
                                    </StackPanel>
                                </Border>
                                <Border Classes="gpanel">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="저장되는 파일" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                                <TextBlock Text="프로그램 옆 logs/날짜/모델명/시각_session_번호/ 폴더" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <Grid ColumnDefinitions="118,*" Margin="0,3"><TextBlock Text="session.raw" FontFamily="Menlo, Consolas, monospace" FontSize="12" Foreground="#0A60D0" VerticalAlignment="Top" /><TextBlock Grid.Column="1" Text="장비가 보낸 바이트 원본(수신만)" TextWrapping="Wrap" /></Grid>
                                <Grid ColumnDefinitions="118,*" Margin="0,3"><TextBlock Text="session.hex" FontFamily="Menlo, Consolas, monospace" FontSize="12" Foreground="#0A60D0" VerticalAlignment="Top" /><TextBlock Grid.Column="1" Text="송수신 HEX 기록" TextWrapping="Wrap" /></Grid>
                                <Grid ColumnDefinitions="118,*" Margin="0,3"><TextBlock Text="session.log" FontFamily="Menlo, Consolas, monospace" FontSize="12" Foreground="#0A60D0" VerticalAlignment="Top" /><TextBlock Grid.Column="1" Text="사람이 읽는 기록과 오류" TextWrapping="Wrap" /></Grid>
                                <Grid ColumnDefinitions="118,*" Margin="0,3"><TextBlock Text="metadata.json" FontFamily="Menlo, Consolas, monospace" FontSize="12" Foreground="#0A60D0" VerticalAlignment="Top" /><TextBlock Grid.Column="1" Text="제조사, 모델, 통신 설정, 시작 시각" TextWrapping="Wrap" /></Grid>
                                <TextBlock Text="[지우기]는 화면만 지우며 저장된 파일은 그대로입니다." Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="gpanel">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="문제가 생기면" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                                <Grid ColumnDefinitions="16,*" Margin="0,3"><TextBlock Text="•" Opacity="0.5" /><TextBlock Grid.Column="1" Text="포트가 없음: 케이블과 드라이버(FTDI, CH340 등)를 확인하고 [새로고침]을 누르세요." TextWrapping="Wrap" /></Grid>
                                <Grid ColumnDefinitions="16,*" Margin="0,3"><TextBlock Text="•" Opacity="0.5" /><TextBlock Grid.Column="1" Text="연결 오류: 다른 프로그램이 포트를 쓰고 있는지 확인하세요." TextWrapping="Wrap" /></Grid>
                                <Grid ColumnDefinitions="16,*" Margin="0,3"><TextBlock Text="•" Opacity="0.5" /><TextBlock Grid.Column="1" Text="오류 문구는 창 아래쪽에 빨간 글씨로 표시됩니다." TextWrapping="Wrap" /></Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBlock Text="© 2026 Junhwan Lee" FontSize="11" Opacity="0.5" HorizontalAlignment="Center" />
            </StackPanel>
            </Grid>

            <!-- 우측: 로그 + 송신 -->
            <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="16">
                <Border Grid.Row="0" Classes="card panel">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14">
                            <TextBlock Classes="cardTitle" Text="수신 / 송신 로그" Margin="0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding RxByteCount, StringFormat='RX {0:N0} B'}" Foreground="#3B82F6" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding TxByteCount, StringFormat='TX {0:N0} B'}" Foreground="#F59E0B" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12">
                                <CheckBox Content="자동 스크롤" IsChecked="{Binding AutoScroll}" />
                                <Button Content="화면 지우기" Command="{Binding ClearCommand}" Padding="12,4" />
                            </StackPanel>
                        </Grid>
                        <ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding LogEntries}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:LogEntry">
                                    <Border Classes="logItem"
                                            Classes.tx="{Binding Direction, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:LogDirection.Tx}}">
                                        <StackPanel Spacing="3">
                                            <TextBlock Classes="mono" Text="{Binding Header}" FontWeight="SemiBold" />
                                            <TextBlock Classes="mono" Text="{Binding HexLine}" />
                                            <TextBlock Classes="mono" Text="{Binding AsciiLine}" Opacity="0.7" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Classes="card panel">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="cardTitle" Text="송신" Margin="0" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <ComboBox Grid.Column="0" ItemsSource="{Binding TxModes}" SelectedItem="{Binding TxMode}" MinWidth="100" />
                            <TextBox Grid.Column="1" Text="{Binding TxText}" PlaceholderText="ASCII 문자 또는 HEX 바이트 (02 01 03)" />
                            <Button Grid.Column="2" Classes="accent" Content="보내기" Command="{Binding SendCommand}" MinWidth="90" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 하단 상태/오류 -->
        <Border Grid.Row="2" Classes="card panel" Padding="14,10"
                IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding LastError}" Foreground="#E5484D" TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
